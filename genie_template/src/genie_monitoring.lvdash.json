{
  "datasets": [
    {
      "name": "quality_runs",
      "displayName": "Quality runs",
      "queryLines": [
        "SELECT checked_at, target, version, mode, passed, accuracy, num_correct, graded, num_bad,\n",
        "       num_needs_review, unhealthy_checks, reasons\n",
        "FROM genie_quality_runs\n",
        "WHERE checked_at >= current_date() - INTERVAL 90 DAYS"
      ]
    },
    {
      "name": "latest_gate",
      "displayName": "Latest gate",
      "queryLines": [
        "SELECT accuracy, num_correct, graded, num_bad, unhealthy_checks, checked_at, version\n",
        "FROM genie_quality_runs\n",
        "WHERE mode = 'gate'\n",
        "ORDER BY checked_at DESC\n",
        "LIMIT 1"
      ]
    },
    {
      "name": "wrong_answers",
      "displayName": "Wrong answers in the latest run",
      "queryLines": [
        "SELECT checked_at, target, version, question, reason, genie_sql, expected_sql\n",
        "FROM genie_quality_results\n",
        "WHERE assessment = 'BAD'\n",
        "QUALIFY dense_rank() OVER (PARTITION BY target ORDER BY checked_at DESC) = 1"
      ]
    },
    {
      "name": "table_health",
      "displayName": "Table health (latest)",
      "queryLines": [
        "SELECT checked_at, target, table_name, check_name, passed, observed, detail\n",
        "FROM genie_table_health\n",
        "QUALIFY dense_rank() OVER (PARTITION BY target ORDER BY checked_at DESC) = 1"
      ]
    },
    {
      "name": "usage_daily",
      "displayName": "Usage per day",
      "queryLines": [
        "SELECT date_trunc('DAY', created_at) AS day, target,\n",
        "       COUNT(*) AS questions,\n",
        "       COUNT(DISTINCT user_id) AS users,\n",
        "       AVG(CASE WHEN status <> 'COMPLETED' THEN 1.0 ELSE 0.0 END) AS failed_share,\n",
        "       SUM(CASE WHEN feedback_rating = 'NEGATIVE' THEN 1 ELSE 0 END) AS thumbs_down\n",
        "FROM genie_usage_messages\n",
        "WHERE created_at >= current_date() - INTERVAL 90 DAYS\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "usage_7d",
      "displayName": "Usage, last 7 days",
      "queryLines": [
        "SELECT COUNT(*) AS questions, COUNT(DISTINCT user_id) AS users,\n",
        "       AVG(CASE WHEN status <> 'COMPLETED' OR feedback_rating = 'NEGATIVE' THEN 1.0 ELSE 0.0 END) AS failed_share\n",
        "FROM genie_usage_messages\n",
        "WHERE created_at >= current_timestamp() - INTERVAL 7 DAYS"
      ]
    },
    {
      "name": "to_review",
      "displayName": "Questions to review",
      "queryLines": [
        "SELECT created_at, target, question, status, error, feedback_rating, genie_sql\n",
        "FROM genie_usage_messages\n",
        "WHERE (status <> 'COMPLETED' OR feedback_rating = 'NEGATIVE')\n",
        "  AND created_at >= current_date() - INTERVAL 30 DAYS\n",
        "ORDER BY created_at DESC\n",
        "LIMIT 200"
      ]
    }
  ],
